rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is in the admins collection
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Race data — anyone can read (public app), authenticated users can update (e.g. coach signups), admins can write
    match /races/{raceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photo gallery collection — public read, admin write
    match /photos/{raceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection:
    // Any authorized admin can list/read/write the admins list (to manage coaches)
    // A signed-in user checking their own status can read their own email doc
    match /admins/{email} {
      allow read: if request.auth != null && (isAdmin() || request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Users collection:
    // Users can only read/write their own profile doc (Admins can read for team coordination)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Settings collection (e.g. invite codes):
    // Public read so registration can validate invite codes; only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
