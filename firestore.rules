rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify user has verified email or authenticated via trusted Google OAuth
    function isVerified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper: Head Coach / Founder bootstrap owner check
    function isOwner() {
      return isVerified() &&
        request.auth.token.email.lower() == 'lmiller1708@gmail.com';
    }

    // Helper: Administrator check — requires verified account AND 'admin' or 'owner' role in admins collection
    function isAdmin() {
      return isOwner() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role in ['admin', 'owner']
      );
    }

    // Helper: Check if user is an authorized coach or member (guardians are read-only)
    function canUpdateSignups() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'guardian'
      );
    }

    // Race data:
    // - Public read for race participants, parents, and coaches
    // - Admins can create, delete, and modify all race fields
    // - Coaches/members can ONLY update coachSignups and warmupGroups
    match /races/{raceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        canUpdateSignups() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachSignups', 'warmupGroups'])
      );
    }

    // Photo gallery collection — public read, admin write
    match /photos/{raceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection:
    // - Authenticated users can read the coaches/admins roster
    // - ONLY verified admins/owners can add, edit, or remove administrator/coach records
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Users collection:
    // - Authenticated users can view teammate names and profile photos
    // - Users can only write/edit their own profile
    // - Non-admins cannot elevate their own role
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId && (
        !('role' in request.resource.data) || request.resource.data.role in ['coach', 'guardian', 'member']
      );
      allow update: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Settings collection (e.g. invite codes):
    // Public read so registration can validate invite codes; only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
