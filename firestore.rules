rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is an admin or bootstrap owner
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'lmiller1708@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Race data — public read, authenticated users can update (e.g. coach signups), admins can write
    match /races/{raceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photo gallery collection — public read, admin write
    match /photos/{raceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection:
    // Any authenticated user can read the coaches/admins list
    // Only admins can add or remove coaches
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Users collection:
    // Any authenticated user can view teammates' coach name and photo
    // Users can only write/edit their own profile doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Settings collection (e.g. invite codes):
    // Public read so registration can validate invite codes; only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
