rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify user has verified email or authenticated via trusted Google OAuth
    function isVerified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper: Head Coach / Founder bootstrap owner check
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'lmiller1708@gmail.com';
    }

    // Helper: Administrator check — requires membership in admins collection or founder email
    function isAdmin() {
      return isOwner() || (
        request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role in ['admin', 'owner']
      );
    }

    // Helper: Authorized coach check — requires authenticated user AND registered membership in admins or users collection
    function isAuthorizedCoach() {
      return isOwner() || (
        request.auth != null &&
        request.auth.token.email != null && (
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role in ['coach', 'admin', 'owner']
          ) || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin', 'owner']
          )
        )
      );
    }

    // Race data:
    // - Public read for race participants, parents, and coaches
    // - Admins can create, delete, and modify all race fields
    // - Ordinary coaches can ONLY update coachSignups (and cannot modify signup policy)
    // - Race metadata, warmupGroups, schedule, and guidelines are reserved for admins
    match /races/{raceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthorizedCoach() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachSignups']) &&
        (!('policy' in resource.data.coachSignups) || request.resource.data.coachSignups.policy == resource.data.coachSignups.policy)
      );
    }

    // Photo gallery collection — public read, admin write
    match /photos/{raceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection:
    // - Authenticated users can read the coaches/admins roster
    // - Admins can add, edit, or remove administrator/coach records
    // - Authenticated coaches registering can record their own coach entry
    match /admins/{email} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == email.lower() &&
        request.resource.data.role == 'coach'
      );
      allow update, delete: if isAdmin();
    }

    // Users collection:
    // - Authenticated users can view teammate names and profile photos
    // - Users can write/edit their own profile (cannot escalate role unless admin)
    // - Admins can manage, update, and remove user profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId && (
        !('role' in request.resource.data) ||
        request.resource.data.role in ['guardian', 'coach'] ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Settings collection (e.g. invite codes):
    // Public read so registration can validate invite codes; only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
